# Existing application settings
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admindivya
ADMIN_PASSWORD=replace-before-first-production-run
SESSION_COOKIE_SECURE=0
# Set only when the app is reachable exclusively through this many trusted proxies.
TRUSTED_PROXY_HOPS=0
HOST=0.0.0.0
PORT=8000

# Storage/payment settings
PAYMENT_QR_URL=/static/payment-qr.png
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:8000

# Optional Google OpenID Connect sign-in. These are server-side fallbacks when
# admin-managed credentials are not configured. Keep the client secret private.
# In Google Cloud Console, configure the exact authorized redirect URI:
# ${APP_BASE_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional GitHub OAuth App sign-in. These blank values are examples only;
# the app reads server-side fallbacks from a private .env file, not this file.
# You can also configure credentials through owner-only Website settings.
# Register the callback URL on the GitHub OAuth App and keep secrets private.
# ${APP_BASE_URL}/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
# Existing application settings
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admindivya
ADMIN_PASSWORD=replace-before-first-production-run
SESSION_COOKIE_SECURE=0
# Set only when the app is reachable exclusively through this many trusted proxies.
TRUSTED_PROXY_HOPS=0
HOST=0.0.0.0
PORT=8000

# Storage/payment settings
PAYMENT_QR_URL=/static/payment-qr.png
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:8000

# Optional Google OpenID Connect sign-in. These are server-side fallbacks when
# admin-managed credentials are not configured. Keep the client secret private.
# In Google Cloud Console, configure the exact authorized redirect URI:
# ${APP_BASE_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional GitHub OAuth App sign-in. These blank values are examples only;
# the app reads server-side fallbacks from a private .env file, not this file.
# You can also configure credentials through owner-only Website settings.
# Register the callback URL on the GitHub OAuth App and keep secrets private.
